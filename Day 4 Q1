/*Write a program to swap two numbers without using a third variable*/
#include <stdio.h>
int main() 
{
    int a,b;
    printf("Enter two integers : \n");
    printf("Enter a = ");
    scanf("%d",&a);
    printf("Enter b = ");
    scanf("%d",&b);
    printf("\nBefore swapping : a = %d and b = %d\n",a,b);
    a=a+b;
    b=a-b;
    a=a-b;
    printf("After swapping :  a = %d and b = %d\n",a,b);
    return 0;
}
