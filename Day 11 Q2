/*Write a program to find profit or loss percentage given cost price and selling price.*/
#include <stdio.h>
int main() 
{
    float cp,sp,amt,pct;
    printf("Enter cost price : ");
    scanf("%f",&cp);
    printf("Enter selling price : ");
    scanf("%f",&sp);
    if(sp>cp) 
    {
        amt=sp-cp;
        pct=(amt/cp)*100;
        printf("Profit amount = %.2f\n",amt);
        printf("Profit percentage = %.2f%%\n",pct);
    }
    else if(cp>sp) 
    {
        amt=cp-sp;
        pct=(amt/cp)*100;
        printf("Loss amount = %.2f\n",amt);
        printf("Loss percentage = %.2f%%\n",pct);
    } 
    else 
    {
        printf("No profit, no loss.\n");
    }
    return 0;
}
